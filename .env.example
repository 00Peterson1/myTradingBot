# ============================================================
# Deriv Quantitative Trading Research System
# NEVER commit a .env file with real credentials
# Copy this file to .env and fill in your values
# ============================================================

# ---- Deriv API Credentials --------------------------------
# Get your token from: https://app.deriv.com/account/api-token
# Use a READ-ONLY token for data collection
# Use an appropriate-scope token for trading
DERIV_API_TOKEN=your_api_token_here

# Deriv WebSocket endpoint (do not change unless Deriv changes it)
DERIV_WS_URL=wss://ws.binaryws.com/websockets/v3

# Your Deriv App ID (register at: https://api.deriv.com)
# You can use app_id=1089 for testing but register your own for production
DERIV_APP_ID=1089

# ---- Safety Controls --------------------------------------
# DEMO_TRADING: Enables demo account trading (safe by default)
DEMO_TRADING=true

# LIVE_TRADING: MUST be explicitly set to true AND LIVE_CONFIRMATION=true
# to enable live account trading. Leave false until you are ready.
LIVE_TRADING=false

# LIVE_CONFIRMATION: A second explicit confirmation required alongside LIVE_TRADING=true
LIVE_CONFIRMATION=false

# ---- Database ---------------------------------------------
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=quant_trading
DATABASE_USER=postgres
DATABASE_PASSWORD=your_postgres_password_here
DATABASE_SSL=false

# Connection pool settings
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_IDLE_TIMEOUT_MS=10000
DATABASE_CONNECTION_TIMEOUT_MS=5000

# ---- Risk Limits (defaults — can be overridden at runtime) -
# Maximum risk per trade as fraction of account balance (e.g. 0.01 = 1%)
RISK_MAX_PER_TRADE_FRACTION=0.01

# Maximum total daily loss as fraction of starting balance (e.g. 0.05 = 5%)
RISK_MAX_DAILY_LOSS_FRACTION=0.05

# Maximum drawdown from equity peak before kill switch triggers (e.g. 0.15 = 15%)
RISK_MAX_DRAWDOWN_FRACTION=0.15

# Maximum consecutive losses before cooldown triggers
RISK_MAX_CONSECUTIVE_LOSSES=5

# Cooldown period in seconds after hitting consecutive loss limit
RISK_COOLDOWN_SECONDS=3600

# ---- Data Collection --------------------------------------
# Comma-separated list of symbols to collect (leave empty to auto-discover)
# Example: R_10,R_25,R_50,R_75,R_100,BOOM1000R,CRASH1000R
COLLECT_SYMBOLS=

# Tick history depth to fetch on startup (seconds)
COLLECT_HISTORY_SECONDS=86400

# ---- Logging ----------------------------------------------
# LOG_LEVEL: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# LOG_PRETTY: true for development (human-readable), false for production (JSON)
LOG_PRETTY=true

# ---- Backtesting ------------------------------------------
# Path to store backtest result JSON reports
BACKTEST_OUTPUT_DIR=./backtest-results

# ---- Research ---------------------------------------------
# Significance level for hypothesis tests (e.g. 0.05 = 5%)
RESEARCH_SIGNIFICANCE_LEVEL=0.05

# Minimum number of observations required before running tests
RESEARCH_MIN_OBSERVATIONS=1000
