{
  "name": "myTradingBot",
  "version": "0.1.0",
  "description": "Quantitative trading research and execution system for Deriv Synthetic Indices",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "build:watch": "tsc --project tsconfig.json --watch",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "migrate": "tsx src/cli/migrate.ts",
    "research": "tsx src/cli/research.ts",
    "research:daemon": "tsx src/cli/research-daemon.ts",
    "markets": "tsx src/cli/markets.ts",
    "backtest": "tsx src/cli/backtest.ts",
    "trade:demo": "tsx src/cli/trade-demo.ts",
    "trade:live": "tsx src/cli/trade-live.ts",
    "sidecar:train": "cd python && python spread_model/train.py",
    "sidecar:serve": "cd python && uvicorn spread_model.serve:app --port 8765 --reload",
    "typecheck": "tsc --noEmit",
    "doctor": "tsx src/cli/doctor.ts"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "@types/better-sqlite3": "^9.6.0",
    "better-sqlite3": "^13.0.3",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.4.5",
    "pg": "^8.13.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "typescript-eslint": "^8.70.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.1",
    "@types/pg": "^8.11.10",
    "@types/ws": "^8.5.13",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.16.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite-tsconfig-paths": "^6.1.1",
    "vitest": "^2.1.8"
  }
}
